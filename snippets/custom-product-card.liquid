{% comment %}
  Renders a product card

  Accepts:
  - card_product: {Object} Product Liquid object (optional)
  - skip_assets: {Boolean} Don't include component styles and scripts. Useful when rendering multiple product cards in a loop. Default: false (optional)

  Usage:
  {% render 'custom-product-card' %}
{% endcomment %}

{%- unless skip_assets -%}
  {{ 'custom-product-card.css' | asset_url | stylesheet_tag }}

  <script src="{{ 'custom-product-card.js' | asset_url }}" defer="defer"></script>
{%- endunless -%}

{%- style -%}
  custom-product-card {
    --card-color-border: {{ settings.card_border_color }};
    --card-primary-color: {{ settings.card_primary_color }};
    --card-secondary-color: {{ settings.card_secondary_color }};
    --card-bg-hover-color: {{ settings.card_bg_hover }};
    --card-border-hover-color: {{ settings.card_border_color_hover }};
    --card-button-bg: {{ settings.card_button_bg }};

    --card-tag-bg-color: #ffd64f;
    --card-additional-badge-color: #fff;
    --card-box-shadow-hover-color: #302a2514;
  }
{%- endstyle -%}

{%- if card_product and card_product != empty -%}
  <custom-product-card
    class="color-{{ settings.card_color_scheme }} gradient"
  >
    <div class="custom-product-card__content">
      <div class="custom-product-card__image">
        <a href="{{ card_product.url }}" class="full-unstyled-link">
          <img
            srcset="
              {%- if card_product.featured_media.width >= 165 -%}{{ card_product.featured_media | image_url: width: 165 }} 165w,{%- endif -%}
              {%- if card_product.featured_media.width >= 360 -%}{{ card_product.featured_media | image_url: width: 360 }} 360w,{%- endif -%}
              {%- if card_product.featured_media.width >= 533 -%}{{ card_product.featured_media | image_url: width: 533 }} 533w,{%- endif -%}
              {%- if card_product.featured_media.width >= 720 -%}{{ card_product.featured_media | image_url: width: 720 }} 720w,{%- endif -%}
              {%- if card_product.featured_media.width >= 940 -%}{{ card_product.featured_media | image_url: width: 940 }} 940w,{%- endif -%}
              {%- if card_product.featured_media.width >= 1066 -%}{{ card_product.featured_media | image_url: width: 1066 }} 1066w,{%- endif -%}
              {{ card_product.featured_media | image_url }} {{ card_product.featured_media.width }}w
            "
            src="{{ card_product.featured_media | image_url: width: 533 }}"
            sizes="(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 130 | divided_by: 4 }}px, (min-width: 990px) calc((100vw - 130px) / 4), (min-width: 750px) calc((100vw - 120px) / 3), calc((100vw - 35px) / 2)"
            alt="{{ card_product.featured_media.alt | escape }}"
            class="motion-reduce"
            {% unless lazy_load == false %}
              loading="lazy"
            {% endunless %}
            width="{{ card_product.featured_media.width }}"
            height="{{ card_product.featured_media.height }}"
          >

          {%- if card_product.tags.size > 0 -%}
            <ul class="custom-product-card__tags list-unstyled">
              {%- for tag in card_product.tags -%}
                <li>{{ tag }}</li>
              {%- endfor -%}
            </ul>
          {%- endif -%}

          {%- if card_product.metafields.custom.aditional_badge != blank -%}
            <div class="custom-product-card__additional-badge">
              {{ card_product.metafields.custom.aditional_badge.value }}
            </div>
          {%- endif -%}
        </a>
      </div>
      <div class="custom-product-card__content">
        <div class="custom-product-card__title">
          {%- if card_product.type != blank -%}
            <div class="custom-product-card__type">
              {{ card_product.type }}
            </div>
          {%- endif -%}

          <a
            href="{{ card_product.url }}"
            class="full-unstyled-link"
          >
            {{ card_product.title | escape }}
          </a>
        </div>
        <div class="custom-product-card__buy">
          <div class="custom-product-card__price">
            {% if card_product.available %}
              <span class="custom-product-card__price-value">
                {{ card_product.price | money }}
              </span>

              {% if card_product.metafields.custom.product_weight_per_unit != blank %}
                <span class="custom-product-card__price-unit">
                  / {{ card_product.metafields.custom.product_weight_per_unit.value }}
                </span>
              {% endif %}
            {% else %}
              <span class="custom-product-card__price-unavailable"> {{ 'products.product.sold_out' | t }} </span>
            {% endif %}
          </div>
          <div class="custom-product-card__product-form">
            {% if card_product.available %}
              {% assign product_form_id = 'product-form-'
                | append: section_id
                | append: card_product.selected_or_first_available_variant.id
              %}

              {%- form 'product',
                card_product,
                id: product_form_id,
                class: 'form',
                novalidate: 'novalidate',
                data-type: 'add-to-cart-form'
              -%}
                <input
                  type="hidden"
                  name="id"
                  value="{{ card_product.selected_or_first_available_variant.id }}"
                  class="product-variant-id"
                >

                <input
                  type="hidden"
                  name="quantity"
                  value="1"
                  class="product-quantity"
                >

                <div class="product-form__button">
                  <button
                    id="ProductSubmitButton-{{ card_product.selected_or_first_available_variant.id }}"
                    type="submit"
                    name="add"
                    class="product-form__submit"
                  >
                    <span class="product-form__button-current-qty"> </span>
                    <span class="product-form__button-icon">
                      {{- 'shop-bag.svg' | inline_asset_content -}}
                    </span>
                  </button>
                </div>

                <div class="product-form__quantity-controls hidden">
                  <button class="quantity-controls quantity-controls__decrease">
                    {{- 'minus.svg' | inline_asset_content -}}
                  </button>
                  <span class="quantity-controls__display">1 шт</span>
                  <button class="quantity-controls quantity-controls__increase">
                    {{- 'plus.svg' | inline_asset_content -}}
                  </button>
                </div>
              {%- endform -%}
            {% else %}
              <div class="custom-product-card__unavailable-icon">
                {{- 'icon-bell.svg' | inline_asset_content -}}
              </div>
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  </custom-product-card>
{%- endif -%}
